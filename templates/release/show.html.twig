{% extends 'artist/base.html.twig' %}

{% block title %}Release{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-auto">
            <img src="{{ release.thumbnail }}" alt="Illustration d'album" style="width: 10rem;">
        </div>
        <div class="col">
            <h2>{{ release.title }}</h2>

            {% for track in release.tracks %}

            {% else %}
                <p>Aucune morceau trouvé.</p>
            {% endfor %}
        </div>
    </div>
{% endblock %}
