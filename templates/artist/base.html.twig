{% extends 'base.html.twig' %}

{% block title %}{{ artist.name }}{% endblock %}

{% block body %}
    {# Toolbar #}
    <div class="row align-items-center mb-3">
        <div class="col-auto">
            <a class="btn-subtle" href="{{ path('app_artist_index') }}">
                <i data-lucide="arrow-left"></i>
            </a>
        </div>

        <div class="col">
            <h1 class="mb-0 fs-xl">{{ artist.name }}</h1>
        </div>

        <div class="col-auto d-flex column-gap-2">
            <a href="{{ path('app_artist_release_new', { id: artist.id }) }}" class="btn-subtle theme-primary">
                <i data-lucide="plus"></i>
            </a>
            <a class="btn-subtle w-100" href="{{ path('app_artist_edit', {'id': artist.id}) }}">
                <i data-lucide="edit"></i>
            </a>
            {{ include('artist/_delete_form.html.twig') }}
        </div>
    </div>

    {# Contenu de la page #}
    <div class="row">
        {# Sidebar illustration #}
        <div class="sm:col-4 md:col-3">
            <img src="{{ artist.thumbnail }}" alt="Illustration de l'artiste" class="img-fluid w-100 rounded mb-3">

            <div class="d-flex flex-column gap-2">
                <div class="overflow-hidden position-relative" style="max-height: calc(1.5em * 5);">
                    <button class="btn-subtle position-absolute bottom-0 end-0" data-bs-toggle="dialog" data-bs-target="#bio">
                        <i data-lucide="eye"></i>
                    </button>
                    {{ artist.bio | nl2br }}
                </div>
            </div>
        </div>

        {# Contenu principal #}
        <div class="col">
            {% block content %}{% endblock %}
        </div>
    </div>

    <dialog class="dialog dialog-scrollable" id="bio">
        <div class="dialog-header">
            <button type="button" class="btn-close" data-bs-dismiss="dialog" aria-label="Fermer"></button>
        </div>
        <div class="dialog-body">
            {{ artist.bio | nl2br }}
        </div>
    </dialog>
{% endblock %}
